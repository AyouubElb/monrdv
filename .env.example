# Local development defaults. `pnpm dev` copies this file to `.env` on first run.
# These values only work against the local Docker databases; production uses its own `.env` on the server.

LOG_LEVEL=debug

# Postgres roles (created by infra/postgres/init on first start)
POSTGRES_PASSWORD=postgres_local
APP_MIGRATOR_PASSWORD=migrator_local
APP_USER_PASSWORD=user_local

# Runtime connection (app_user) and migration connection (app_migrator)
DATABASE_URL=postgresql://app_user:user_local@localhost:5432/booking
MIGRATE_DATABASE_URL=postgresql://app_migrator:migrator_local@localhost:5432/booking

# Test database (db-test container). Tests refuse to run without these.
TEST_DATABASE_URL=postgresql://app_user:user_local@localhost:5433/booking_test
TEST_MIGRATE_DATABASE_URL=postgresql://app_migrator:migrator_local@localhost:5433/booking_test

# API
API_PORT=3001
TRUSTED_PROXY=loopback,uniquelocal
# Same value as NEXT_PUBLIC_ROOT_DOMAIN
ROOT_DOMAIN=localhost
# Local dummy only. Production uses at least 32 random bytes (for example `openssl rand -base64 48`).
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
# false only for local http; true in production (Secure cookies with __Host- names)
COOKIE_SECURE=false

# Web
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Server only: the web app calls the API over the private network
API_INTERNAL_URL=http://localhost:3001
