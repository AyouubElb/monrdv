{
  "name": "monrdv",
  "description": "MonRDV: a multi tenant booking platform where each salon, clinic, or coach in Morocco gets its own booking site on its own subdomain.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AyouubElb/monrdv.git"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && pnpm db:up && turbo run dev",
    "db:up": "docker compose --env-file .env -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose.dev.yml down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
